MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=deepcut_sports
# Optional: only needed for admin AI draft generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Dedicated key accepted from an internal Adalo Custom Action via X-API-Key.
# Generate a long random value and do not reuse the OpenAI key.
ADALO_API_KEY=
APP_BASE_URL=https://your-web-domain.com
CORS_ORIGINS=https://your-web-domain.com,http://localhost:3000
ADMIN_EMAILS=you@example.com
ADMIN_USER_IDS=
# Legacy alpha switch. Keep blank for the full-app release and open account registration.
BETA_ACCESS_CODE=
# Historical label retained on accounts created during the closed alpha.
BETA_COHORT=closed_alpha_1
# Optional one-time seed list. These emails become pending full-app grants on startup.
# After deployment, manage grants from /admin/users. Admin privilege is never implied.
FULL_APP_BOOTSTRAP_EMAILS=
# Password reset delivery through Resend. Verify the sender domain before launch.
RESEND_API_KEY=
EMAIL_FROM="DeepCut Sports <accounts@your-domain.com>"
# Optional override. Defaults to APP_BASE_URL/reset-password.
PASSWORD_RESET_URL=https://your-web-domain.com/reset-password
